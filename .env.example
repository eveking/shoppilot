# ShopPilot 配置示例：复制为 .env 并按需修改（前缀 SHOPILOT_）

# ---- LLM（OpenAI 兼容协议，默认 DeepSeek）----
SHOPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
SHOPILOT_LLM_API_KEY=sk-xxxxxxxx
SHOPILOT_LLM_MODEL=deepseek-chat

# ---- 身份 ----
# HMAC 签名密钥：生产环境必须换成随机长密钥
SHOPILOT_IDENTITY_SECRET=change-me-to-a-long-random-secret
# demo 模式：true 时创建会话可直接传 user_id，无需签名 token
SHOPILOT_DEMO_MODE=true

# ---- 存储 ----
# 默认 SQLite；迁移 PostgreSQL 时改为 postgresql+asyncpg://user:pass@host/db
SHOPILOT_DATABASE_URL=sqlite+aiosqlite:///./data/shoppilot.db

# ---- Agent 行为 ----
SHOPILOT_AGENT_MAX_TOOL_ROUNDS=8
SHOPILOT_CONTEXT_MAX_MESSAGES=20
SHOPILOT_TOOL_RESULT_MAX_CHARS=6000

# ---- 其他 ----
SHOPILOT_AUTO_MIGRATE=true
SHOPILOT_CORS_ORIGINS=["*"]
